# ===== 模型接入（至少配置一组；密钥不得提交仓库）=====
# Anthropic 兼容端点（DeepSeek 须用 /anthropic 路径；智谱 BigModel 填 https://open.bigmodel.cn/api/anthropic）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=your-key
ANTHROPIC_MODEL=deepseek-flash

# Web 对话/证据问答可单独用更强的模型（可选；不配则与 ANTHROPIC_MODEL 相同）
# 实测 deepseek-flash 倾向拒答或凭记忆作答，证据问答建议 deepseek-v4-pro
# CHAT_MODEL=deepseek-v4-pro

# OpenAI 兼容端点（云模型或本地 vLLM 二选一）
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=your-key
# OPENAI_MODEL=your-model

# ===== 学术搜索 API（可选，未配置时对应工具自动降级）=====
# SEMANTIC_SCHOLAR_API_KEY=

# ===== 联网搜索（可选，自由对话的 🌐 开关；二选一）=====
# ① 阿里云 AnySearch（信息查询服务 IQS“通晓”，https://aliyun.com/product/iqs 控制台创建 API-KEY，约 5 分钟生效）
# WEB_SEARCH_PROVIDER=anysearch
# ANYSEARCH_API_KEY=your-key
# ② 智谱开放平台 https://open.bigmodel.cn（默认服务商，无需 WEB_SEARCH_PROVIDER）
# ZHIPUAI_API_KEY=your-key
# 智谱引擎档位（元/次）：search_std 0.01（默认） / search_pro 0.03 / search_pro_sogou、search_pro_quark 0.05
# WEB_SEARCH_ENGINE=search_std

# ===== 路径（一般无需修改）=====
# RA_DATA_DIR=data
